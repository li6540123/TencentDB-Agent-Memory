# 公司内网测试机模板。复制为 .env 后把 REPLACE_ME / sk-replace-me 换成真值。
#   cp .env.company.example .env
#   编辑 PUBLIC_HOST、两组 LLM URL/Key/模型、REDIS_PASSWORD、TDAI_MAAS_KEY_SECRET
#   ./up.sh --render-only && ./up.sh
#
# 约束（和本机 MiniMax 实验相同，不要改）：
#   MEMORY_CORE_GATEWAY_API_KEY 必须空
#   PROXY_CORE_SERVICE_TOKEN=local
#   Anthropic base 填到 /v1 为止，不要带 /messages（Proxy 会再拼 /messages）
#
# MaaS Key（feat/per-sk-mem-maas-api-key，需自建 core/hub/proxy 镜像）：
#   同事 CLI 只配 Proxy + sk-mem；每人在 Hub「API Keys」行绑 MaaS Key
#   未绑定 → 走 PROXY_UPSTREAM_API_KEY 兜底；不要再用客户端透传网关 Key
#   PROXY_PASSTHROUGH_SOURCES 留空；PROXY_KEY_MODE=server

# ── 镜像（./pack.sh 会打成 :TAG-amd64；本地构建见 ./export-images.sh）──────
MEMORY_CORE_IMAGE=tdai-local/memory-core:20688f9-amd64
MEMORY_HUB_IMAGE=tdai-local/memory-hub:20688f9-amd64
PROXY_IMAGE=tdai-local/memory-proxy:20688f9-amd64
REDIS_IMAGE=redis:7-alpine

# ── Core / Hub：OpenAI 兼容（总结、抽取、Wiki）───────────────────────────
MEMORY_LLM_BASE_URL=https://REPLACE_ME_LLM_GATEWAY/v1
MEMORY_LLM_API_KEY=sk-replace-me
MEMORY_LLM_MODEL=REPLACE_ME_MODEL
MEMORY_LLM_PROTOCOL=openai
MEMORY_LLM_MAX_TOKENS=4096
MEMORY_LLM_TIMEOUT_MS=120000
MEMORY_SKILL_ARCHIVE_BYTES=40960

# ── Proxy 默认上游。Claude Code 必须是 Anthropic Messages 的 base ────────
# 最终请求 = {这行}/messages
# 例：https://gw.example.com/anthropic/v1  →  .../anthropic/v1/messages
PROXY_UPSTREAM_URL=https://REPLACE_ME_LLM_GATEWAY/anthropic/v1
# 其它客户端（CodeBuddy 等）的共用网关 Key；已在 Hub 绑 MaaS 的同事不会用到这把。
PROXY_UPSTREAM_API_KEY=sk-replace-me
PROXY_UPSTREAM_MODEL=REPLACE_ME_MODEL

PROXY_AGENT_SOURCES=claude-code,codebuddy,codex,workbuddy,dsh,hermes,openclaw

# 全部客户端 server 模式；MaaS Key 在 Hub 按 sk-mem 行配置，不再透传
PROXY_KEY_MODE=server
PROXY_PASSTHROUGH_SOURCES=

# 若 CodeBuddy 走 OpenAI、CC 走另一条 Anthropic 路径，取消注释：
# PROXY_CODEBUDDY_URL=https://REPLACE_ME_LLM_GATEWAY/v1
# PROXY_CLAUDE_CODE_URL=https://REPLACE_ME_LLM_GATEWAY/anthropic/v1

MEMORY_CORE_PORT=8420
PANEL_PORT=8125
KNOWLEDGE_PORT=8424
PROXY_PORT=8096

# 同事浏览器 / Claude 访问测试机的局域网 IP 或内网域名，不要 127.0.0.1
PUBLIC_HOST=REPLACE_ME

KNOWLEDGE_PUBLIC_BASE_URL=http://host.docker.internal:8424/v3

REDIS_PASSWORD=replace-with-a-long-random-string

MEMORY_CORE_GATEWAY_API_KEY=
MEMORY_CORE_ADMIN_USERNAME=admin
PROXY_CORE_SERVICE_TOKEN=local

# ── 每把 sk-mem 绑定 MaaS API Key（Hub 配置 + Proxy 转发）────────────────
# Core 加密主密钥（≥32 字节随机串；勿提交 git）
TDAI_MAAS_KEY_SECRET=replace-with-32plus-random-bytes
# Proxy resolve 缓存 TTL / 超时（Hub 成功提示与 PROXY_MAAS_KEY_CACHE_TTL_MS 一致）
PROXY_MAAS_KEY_CACHE_TTL_MS=60000
PROXY_MAAS_KEY_RESOLVE_TIMEOUT_MS=1500

# ── Core 记忆向量 embedding（Qwen3 须 SEND_DIMENSIONS=false）──────────────
# MEMORY_EMBEDDING_ENABLED=true
# MEMORY_EMBEDDING_BASE_URL=https://REPLACE_ME_LLM_GATEWAY/v1
# MEMORY_EMBEDDING_API_KEY=sk-replace-me
# MEMORY_EMBEDDING_MODEL=/models/Qwen3-Embedding
# MEMORY_EMBEDDING_DIMENSIONS=4096
# MEMORY_EMBEDDING_SEND_DIMENSIONS=false

# ── CodeGraph 内网 HTTP Git ───────────────────────────────────────────────
# KNOWLEDGE_ALLOW_HTTP=1
# KNOWLEDGE_GIT_TOKEN=<jenkins-pat>
# KNOWLEDGE_GIT_USERNAME=jenkins
# KNOWLEDGE_SSRF_CHECK=off
