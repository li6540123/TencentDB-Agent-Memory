# 单节点内部部署。复制为 .env 后填真值：
#   cp .env.example .env
#   ./up.sh
# 只想先看生成的 yaml： ./up.sh --render-only

# ── 镜像（建议钉死 tag，不要长期用 latest）────────────────────────────────
# 本地源码构建（./build-local.sh 或 ./up-local.sh）后示例：
MEMORY_CORE_IMAGE=tdai-local/memory-core:20688f9-amd64
MEMORY_HUB_IMAGE=tdai-local/memory-hub:20688f9-amd64
PROXY_IMAGE=tdai-local/memory-proxy:20688f9-amd64
# 官方 Docker Hub（有网且未自建时）：
# MEMORY_CORE_IMAGE=agentmemory/memory-core:latest
# MEMORY_HUB_IMAGE=agentmemory/memory-hub:latest
# PROXY_IMAGE=agentmemory/memory-proxy:latest
REDIS_IMAGE=redis:7-alpine

# ── memory / hub 内部 LLM（embed、总结、wiki）─────────────────────────────
# 和同事对话用的上游可以不是同一个。
MEMORY_LLM_BASE_URL=https://example.com/v1
MEMORY_LLM_API_KEY=sk-replace-me
MEMORY_LLM_MODEL=deepseek-chat
MEMORY_LLM_PROTOCOL=openai
# 输出上限（OpenAI max_tokens）和单次调用等待。外部网关慢/上下文大时先把 maxTokens 降下来，超时再加大。
MEMORY_LLM_MAX_TOKENS=4096
MEMORY_LLM_TIMEOUT_MS=120000
# Skill 抽取送进模型的归档大小（字节）。一次输入太大超时就调小，例如 16384。
MEMORY_SKILL_ARCHIVE_BYTES=40960

# ── proxy 默认上游（coding agent 对话转发到这里）──────────────────────────
# 未出现在 PROXY_AGENT_SOURCES 里的路径会走这两项。
PROXY_UPSTREAM_URL=https://example.com/v1
PROXY_UPSTREAM_API_KEY=sk-replace-me
# 只提示同事 claude --model 填什么，不会做成白名单。
PROXY_UPSTREAM_MODEL=deepseek-chat

# 写入 runtime/proxy-config.yaml 的 upstream.agents 路径前缀。
# 同事在客户端改 Base URL 即可，不必为每种客户端再起一个 proxy。
PROXY_AGENT_SOURCES=claude-code,codebuddy,codex,workbuddy,dsh,hermes,openclaw

# server      = 上表里的客户端都写 PROXY_UPSTREAM_API_KEY（全员共用一把网关 Key）
# passthrough = 上表里的客户端都不写 apiKey，每人自己带网关 Key
PROXY_KEY_MODE=server

# 可选：混合模式。非空时覆盖 PROXY_KEY_MODE 对「谁透传」的判断。
# 例：只有 CC 透传、其余仍用共用 Key：
# PROXY_PASSTHROUGH_SOURCES=claude-code
PROXY_PASSTHROUGH_SOURCES=

# 可选：某个客户端走另一家上游（空 = 用上面的 PROXY_UPSTREAM_*）
# PROXY_CLAUDE_CODE_URL=
# PROXY_CLAUDE_CODE_API_KEY=
# PROXY_CODEBUDDY_URL=
# PROXY_CODEBUDDY_API_KEY=
# PROXY_CODEX_URL=
# PROXY_CODEX_API_KEY=
# PROXY_WORKBUDDY_URL=
# PROXY_WORKBUDDY_API_KEY=
# PROXY_DSH_URL=
# PROXY_DSH_API_KEY=
# PROXY_HERMES_URL=
# PROXY_HERMES_API_KEY=
# PROXY_OPENCLAW_URL=
# PROXY_OPENCLAW_API_KEY=

# ── 端口 ──────────────────────────────────────────────────────────────────
MEMORY_CORE_PORT=8420
PANEL_PORT=8125
KNOWLEDGE_PORT=8424
PROXY_PORT=8096

# 同事浏览器 / 客户端访问这台机器用的地址（必须改成局域网 IP 或域名）
PUBLIC_HOST=127.0.0.1

# Knowledge 容器回连宿主机上的 8424；Docker Desktop / 本 compose 已加 host-gateway
KNOWLEDGE_PUBLIC_BASE_URL=http://host.docker.internal:8424/v3

# ── Redis（Proxy 会话绑定；容器重建后不丢「关联团队资产」）────────────────
REDIS_PASSWORD=replace-with-a-long-random-string

# ── Core 管理口令：必须留空，否则 Proxy 的 auth/sessionInit 会失败 ────────
MEMORY_CORE_GATEWAY_API_KEY=
MEMORY_CORE_ADMIN_USERNAME=admin

# Hub / Proxy 调 Core 的 v3（知识库 list、skill search）需要非空 Bearer。
# Core 关了网关 Key 时不校验内容，但空字符串会：1) Hub 起不来 2) 知识库 injector 不注册。
# 不要把这个值写进 MEMORY_CORE_GATEWAY_API_KEY。
PROXY_CORE_SERVICE_TOKEN=local

# ── 每把 sk-mem 绑定 MaaS API Key（Hub 配置 + Proxy 转发）────────────────
# Core 加密主密钥（≥32 字节随机串；勿提交真实值）
TDAI_MAAS_KEY_SECRET=replace-with-32plus-random-bytes
# Proxy resolve 缓存 TTL / 超时（Hub 成功提示文案与 PROXY_MAAS_KEY_CACHE_TTL_MS 一致）
PROXY_MAAS_KEY_CACHE_TTL_MS=60000
PROXY_MAAS_KEY_RESOLVE_TIMEOUT_MS=1500

# ── Core 记忆向量 embedding（hybrid 召回；默认关闭）──────────────────────
# Qwen3 / BGE-M3 等不支持 matryoshka 的模型必须 MEMORY_EMBEDDING_SEND_DIMENSIONS=false
# MEMORY_EMBEDDING_ENABLED=true
# MEMORY_EMBEDDING_PROVIDER=openai
# MEMORY_EMBEDDING_BASE_URL=https://example.com/v1
# MEMORY_EMBEDDING_API_KEY=sk-replace-me
# MEMORY_EMBEDDING_MODEL=/models/Qwen3-Embedding
# MEMORY_EMBEDDING_DIMENSIONS=4096
# MEMORY_EMBEDDING_SEND_DIMENSIONS=false

# ── CodeGraph 内网 HTTP Git（Hub 容器；默认关闭，仅 https）────────────────
# KNOWLEDGE_ALLOW_HTTP=1
# KNOWLEDGE_GIT_TOKEN=<jenkins-pat>
# KNOWLEDGE_GIT_USERNAME=jenkins
# KNOWLEDGE_SSRF_CHECK=off          # 内网 IP 仓库时需要

# ── 本地 build-local.sh 构建镜像时走翻墙（Clash HTTP 代理端口）──────────────
BUILD_PROXY_PORT=7897
